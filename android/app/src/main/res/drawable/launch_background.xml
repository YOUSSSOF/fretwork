<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window. Solid surface0 from app_colors.dart, so the handoff to
     the Flutter UI is invisible rather than a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fretwork_surface" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
